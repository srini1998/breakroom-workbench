    {
      "role": "member",
      "action": "attachment",
      "allow": false
    },
    {
      "role": "member",
      "action": "reassign",
      "allow": false
    },
    {
      "role": "contractor",
      "action": "read_own",
      "allow": true
    },
    {
      "role": "contractor",
      "action": "read_foreign",
      "allow": false
    },
    {
      "role": "contractor",
      "action": "write_own",
      "allow": false
    },
    {
      "role": "contractor",
      "action": "unassigned",
      "allow": false
    },
    {
      "role": "contractor",
      "action": "attachment",
      "allow": false
    },
    {
      "role": "contractor",
      "action": "reassign",
      "allow": false
    }
  ]
}