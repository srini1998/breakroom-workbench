{
  "version": 1,
  "name": "Team audience contract",
  "scope": "breakroom-two-tenant-fixture",
  "rules": [
    {
      "role": "owner",
      "action": "read_own",
      "allow": true
    },
    {
      "role": "owner",
      "action": "read_foreign",
      "allow": false
    },
    {
      "role": "owner",
      "action": "write_own",
      "allow": true
    },
    {
      "role": "owner",
      "action": "unassigned",
      "allow": true
