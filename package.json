{
  "name": "breakroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "worker": "node --import tsx server/worker.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "migrate": "node --import tsx scripts/setup.ts --migrate",
    "seed": "node --import tsx scripts/setup.ts --seed",
    "smoke": "node --import tsx scripts/smoke.ts",
    "local:db": "bash scripts/local-db.sh",
    "services": "bash scripts/services.sh",
    "services:status": "supabase status",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "ready": "node --import tsx scripts/ready.ts",
    "reset:run": "node --import tsx scripts/reset-run.ts",
    "setup:supabase": "node --import tsx scripts/setup-supabase.ts",
    "env:supabase": "node --import tsx scripts/supabase-env.ts",
    "verify:product": "node --import tsx scripts/verify-product.ts",
    "verify:auth": "node --import tsx scripts/verify-auth.ts",
    "verify:restart": "node --import tsx scripts/verify-event-restart.ts",
    "verify:erasure": "node --import tsx scripts/verify-erasure-race.ts",
    "verify:import": "node --import tsx scripts/verify-import.ts",
    "setup:isolation": "node --import tsx scripts/isolate-credentials.ts",
    "verify:isolation": "node --import tsx scripts/verify-isolation.ts",
    "evaluate": "bash scripts/evaluate-all.sh",
    "setup:switchboard": "npm run migrate && node --import tsx scripts/setup-switchboard.ts",
    "verify:switchboard": "node --import tsx scripts/verify-switchboard.ts",
    "verify:switchboard:browser": "node --import tsx scripts/browser-switchboard.ts",
    "verify:switchboard:lifecycle": "node --import tsx scripts/verify-switchboard-lifecycle.ts",
    "smoke:switchboard": "node --import tsx scripts/smoke-switchboard.ts",
    "reset:switchboard": "node --import tsx scripts/reset-switchboard.ts",
    "report:switchboard": "node --import tsx scripts/report-switchboard.ts",
    "verify:switchboard:matrix": "node --import tsx scripts/verify-switchboard-recipient-matrix.ts",
    "preflight": "node --import tsx scripts/policy-passport.ts",
    "data:refresh": "node --import tsx scripts/fetch-product-data.ts",
    "verify:practical": "node --import tsx scripts/verify-practical.ts",
    "build:public": "node --import tsx scripts/build-public.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
