# Generate the private local profile with npm run env:supabase, setup:supabase, setup:isolation.
PORT=4310
DATABASE_URL=postgresql://breakroom_control_owner:REPLACE@127.0.0.1:54322/breakroom_control
TARGET_DATABASE_URL=postgresql://breakroom_target_owner:REPLACE@127.0.0.1:54322/postgres
LOCAL_FIXTURE_AUTH=false
DEMO_AUTH_ENABLED=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TARGET_SUPABASE_URL=http://127.0.0.1:54321
TARGET_SUPABASE_SERVICE_ROLE_KEY=
FIXTURE_PASSWORD=
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:3b
MODEL_TIMEOUT_MS=30000
MODEL_API_KEY=
# Free cloud alternative (Groq free plan, no card; key stays server-side in this local .env only):
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=openai/gpt-oss-20b
# MODEL_API_KEY=<your Groq key>
# MODEL_REASONING_EFFORT=low

# Upper bound for Switchboard ordinary subscriber connections (hard ceiling 50).
SWITCH_MAX_SUBSCRIBERS=50
